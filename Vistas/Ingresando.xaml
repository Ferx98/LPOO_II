<Window x:Class="Vistas.Ingresando"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresando" Height="330" Width="610"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded">
    <Border CornerRadius="12" Background="#FAFAFA" Padding="5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid Focusable="False" OpacityMask="{x:Null}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Height="150" HorizontalAlignment="Center" Margin="212,35,214,0" Name="image1" Stretch="Fill" VerticalAlignment="Center" Width="150" Source="/Vistas;component/Images/logo1.png" />
            <TextBlock Grid.Row="1" Text="Cargando..." HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="White" FontFamily="Verdana" FontWeight="Bold" FontSize="18"/>
            <ProgressBar x:Name="progressBar" Grid.Row="2" Height="22" Minimum="0" Maximum="100" Foreground="#39E3FF" Background="#0A2234" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="40,20" Width="570"/>
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF175A84" Offset="0" />
                    <GradientStop Color="#FF072D50" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>
    </Border>
</Window>
