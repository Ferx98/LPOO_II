<Window x:Class="Vistas.WinListaInscriptos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:coleccionUsuario="clr-namespace:ClasesBase;assembly=ClasesBase"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Listado de Inscriptos" Height="450" Width="739"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Loaded="Window_Loaded"
        Background="#EAFAF1">
    <Window.Resources>
        <ObjectDataProvider 
            x:Key="LIST_INSCRIPTOS"
            ObjectType="{x:Type coleccionUsuario:TrabajarInscripciones}"
            MethodName="TraerInscripcionesColeccion" />

        <CollectionViewSource 
            x:Key="VISTA_INSCRIPTOS"
            Source="{Binding Source={StaticResource LIST_INSCRIPTOS}}" />

        <Style x:Key="GreenHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Filtros de Búsqueda" Grid.Row="0" Margin="0,0,0,10" BorderBrush="#27AE60">
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <Label Content="DNI del Alumno:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>

                <TextBox Name="txtFiltro" Width="200" Height="25" VerticalContentAlignment="Center" />

                <Button Name="btnBuscar" Content="Buscar" Width="100" Height="25" Margin="15,0,0,0" 
                        Click="btnBuscar_Click" Background="#D5F5E3" BorderBrush="#2ECC71"/>
            </StackPanel>
        </GroupBox>

        <DataGrid Name="dgInscriptos"
                  Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource VISTA_INSCRIPTOS}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  ColumnHeaderStyle="{StaticResource GreenHeaderStyle}"
                  Background="White" BorderBrush="#27AE60" BorderThickness="1">

            <DataGrid.RowBackground>White</DataGrid.RowBackground>
            <DataGrid.AlternatingRowBackground>#F2F4F4</DataGrid.AlternatingRowBackground>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Ins_ID}" Width="50"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding Alu_DNI}" Width="100" />
                <DataGridTextColumn Header="Apellido y Nombre" Binding="{Binding AlumnoNombreCompleto}" Width="200" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding Ins_Fecha, StringFormat=dd/MM/yyyy}" Width="100" />
                <DataGridTextColumn Header="Curso" Binding="{Binding CursoNombre}" Width="150" />
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDescripcion}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ResourceKey=btn_plantilla_limpiar}" Content="Volver al Menu" Height="30" Name="btnAtras" Click="btnAtras_Click" Margin="286,0,280,0" />
        </Grid>
    </Grid>
</Window>