<Window x:Class="Vistas.WinListaInscriptos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:coleccionUsuario="clr-namespace:ClasesBase;assembly=ClasesBase"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Listado de Inscriptos" Height="369" Width="700"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Window.Resources>
        <!-- TRAE LOS INSCRIPTOS EN UN DATATABLE -->
        <ObjectDataProvider 
        x:Key="LIST_INSCRIPTOS"
        ObjectType="{x:Type coleccionUsuario:TrabajarInscripciones}"
        MethodName="TraerInscriptos" />

        <ObjectDataProvider
        x:Key="LIST_CURSOS"
        ObjectType="{x:Type coleccionUsuario:TrabajarCursos}"
        MethodName="TraerCursosProgramados"/>

        <!-- CONVIERTE EL DATATABLE A UNA VISTA PARA EL DATAGRID -->
        <CollectionViewSource 
        x:Key="VISTA_INSCRIPTOS"
        Source="{Binding Source={StaticResource LIST_INSCRIPTOS}}" />
    </Window.Resources>
    <Grid Margin="10" Width="660">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="29*" />
            <ColumnDefinition Width="270*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="79*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="81*" />
            <RowDefinition Height="111*" />
            <RowDefinition Height="29*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,22" Grid.ColumnSpan="3" Background="LightBlue">
            <Label Content="DNI:" VerticalAlignment="Center" FontSize="12" />
            <TextBox Name="txtFiltro" Width="200" TextChanged="txtFiltro_TextChanged" VerticalAlignment="Center"/>

            <Label Content="Curso:" VerticalAlignment="Center" FontSize="12" />
            <ComboBox Height="19"  Width="200"  x:Name="cmbCursos" ItemsSource="{Binding Source={StaticResource LIST_CURSOS}}" DisplayMemberPath="Cur_Nombre" SelectedValuePath="Cur_ID" SelectionChanged="cmbCursos_SelectionChanged" />
        </StackPanel>

        <DataGrid Name="dgInscriptos"
                  ItemsSource="{Binding Source={StaticResource VISTA_INSCRIPTOS}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="LightBlue" Margin="0,75,0,22" Grid.ColumnSpan="3"
                  ColumnHeaderStyle="{StaticResource EncabezadoDataGrid}" Grid.RowSpan="4" SelectionChanged="dgInscriptos_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ins_ID}" />
                <DataGridTextColumn Header="DNI" Binding="{Binding alu_DNI}" Width="100" />
                <DataGridTextColumn Header="Apellido y Nombre" Binding="{Binding Alumno}" Width="140" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding ins_Fecha}" Width="140" />
                <DataGridTextColumn Header="Curso" Binding="{Binding Curso}" Width="150" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Style="{StaticResource btnAtras}" Content="Atras" Grid.Row="3" Height="33" HorizontalAlignment="Left" Margin="0,95,0,0" Name="btnAtras" VerticalAlignment="Top" Width="86" Click="btnAtras_Click" Grid.RowSpan="2" Grid.ColumnSpan="2" Grid.Column="1" />
        <Button Style="{StaticResource btnAtras}" Content="Vista Previa" Grid.Row="3" Height="33" HorizontalAlignment="Left" Margin="210,95,0,0" Name="btnVistaPrevia" VerticalAlignment="Top" Width="86" Click="btnVistaPrevia_Click" Grid.Column="2" Grid.RowSpan="2" />
    </Grid>
</Window>
