<Window x:Class="Vistas.WinAnularInscripcion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClasesBase;assembly=ClasesBase"
        Title="Anular Inscripcion" Height="725" Width="1010" WindowStartupLocation="CenterScreen" Background="#FAF0E6" BorderBrush="#FF5834CB" Closing="Window_Closing">
    <Window.Resources>
        <ObjectDataProvider x:Key="LIST_DNI_INSCRIPTOS"
                        ObjectType="{x:Type svc:TrabajarInscripciones}"
                        MethodName="TraerDNIAlumnosInscriptos" />
    </Window.Resources>
    <Grid Width="1005">
        <ComboBox x:Name="cmbDNIAlumnos"
          ItemsSource="{Binding Source={StaticResource LIST_DNI_INSCRIPTOS}}"
          DisplayMemberPath="alu_DNI"
          SelectedValuePath="alu_DNI"
          Width="227" Height="28" Margin="412,259,0,0"
          HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="cmbDNIAlumnos_SelectionChanged" FontFamily="Arial" FontSize="15" />
        <ListView Height="244"
          HorizontalAlignment="Left"
          Margin="211,0,0,129"
          VerticalAlignment="Bottom"
          Width="596" Name="listCursos" SelectionChanged="listCursos_SelectionChanged" FontFamily="Arial" Background="#FFE5EFEA" Foreground="Black" BorderBrush="#FF6726F5">
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <StaticResource ResourceKey="gdrEncabezados"/>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="Curso" Width="130" DisplayMemberBinding="{Binding cur_Nombre}" />
                    <GridViewColumn Header="Apellido y Nombre" Width="180" DisplayMemberBinding="{Binding Alumno}" />
                    <GridViewColumn Header="Fecha de Inscripcion" Width="140">
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="ins_Fecha" StringFormat="{}{0:dd/MM/yyyy}" />
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <RadioButton Content="Anular Inscripcion" Height="16" HorizontalAlignment="Left" Margin="436,613,0,0" Name="rdbAnular" VerticalAlignment="Top" Checked="rdbAnular_Checked" FontFamily="Arial" FontSize="16" Foreground="#FFBA2121" />
        <Label Content="Gestión de Anulacion de Inscripciones" Height="42" HorizontalAlignment="Left" Margin="242,21,0,0" Name="label1" VerticalAlignment="Top" FontFamily="Lune" FontSize="28" FontWeight="ExtraBold" Foreground="#FF1F8907" />
        <Image Height="150" HorizontalAlignment="Left" Margin="412,69,0,0" Name="image1" Stretch="Fill" VerticalAlignment="Top" Width="200" Source="/Vistas;component/Images/GestionDocentes.png" />
        <Label Content="Elija el documento del alumno que desea anular su inscripcion" Height="28" HorizontalAlignment="Left" Margin="298,225,0,0" Name="label2" VerticalAlignment="Top" FontFamily="Lune" FontSize="16" Foreground="#FF3E9DCB" />
        <Label Content="Seleccione una inscripcion de la grilla para anularla" Height="28" HorizontalAlignment="Left" Margin="334,579,0,0" Name="label3" VerticalAlignment="Top" FontFamily="Lune" FontSize="16" Foreground="#FF3E9DCB" />
        <Button Style="{StaticResource ResourceKey=btn_plantilla_atras}" Content="Atrás" Height="32" HorizontalAlignment="Left" Margin="92,613,0,0" Name="btnAtras" VerticalAlignment="Top" Width="75" Click="btnAtras_Click" />
    </Grid>
</Window>
