<Window x:Class="Vistas.WinAnularInscripcion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anular Inscripción" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" Background="#FAF0E6"
        Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Gestión de Anulación de Inscripciones" 
               FontSize="20" FontWeight="Bold" Foreground="#FF1F8907" HorizontalAlignment="Center"/>

        <GroupBox Grid.Row="1" Header="Seleccione Alumno" Margin="0,10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="DNI del Alumno:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbDNIAlumnos" Width="200" Height="25" 
                          SelectionChanged="cmbDNIAlumnos_SelectionChanged"/>

                <Label Content="(Solo se muestran alumnos con inscripciones activas)" 
                       FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <ListView x:Name="listCursos" Grid.Row="2" Margin="114,0,91,20" 
                  Background="White" BorderBrush="#FF6726F5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Curso" Width="200" 
                                    DisplayMemberBinding="{Binding CursoNombre}" />

                    <GridViewColumn Header="Alumno" Width="200" 
                                    DisplayMemberBinding="{Binding AlumnoNombreCompleto}" />

                    <GridViewColumn Header="Fecha Inscripción" Width="150">
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Ins_Fecha" StringFormat="dd/MM/yyyy" />
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button x:Name="btnAtras" Style="{StaticResource ResourceKey=btn_plantilla_limpiar}" Content="Atrás" Width="100" Height="30" Margin="0,0,10,0"
                    Click="btnAtras_Click"/>

            <Button x:Name="btnAnular" Style="{StaticResource btn_plantilla_atras}"  Content="Anular Inscripción" Width="150" Height="30" 
                    Click="btnAnular_Click" Background="#FFBA2121" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>